# Copy this file to `.env` (or `.env.local`) for frontend runtime.
# Example (PowerShell): Copy-Item .env.example .env

# The frontend normalizes this value to always call `/api/...`.
# Both forms below are valid; do not add `/api` twice.

# If frontend is served behind backend proxy:
# VITE_API_URL=/api

# If running frontend + backend separately in local dev:
VITE_API_URL=http://localhost:8000

# If pointing directly to deployed backend, either of these works:
# VITE_API_URL=https://url-backend-deploy
# VITE_API_URL=https://url-backend-deploy/api
#
# For Vercel production, see `.env.production.example` and set the value
# in Vercel Project Settings because Vite embeds env values at build time.
